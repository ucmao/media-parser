# ==========================================
# Media Parser 环境变量配置示例
# 复制本文件为 .env 并根据实际需求填入对应配置
# ==========================================

# ------------------------------------------
# 1. 基础运行与安全配置 (Core & Security)
# ------------------------------------------
# Flask 会话加密密钥（生产环境建议配置固定强随机字符串，留空则自动生成并持久化保存在 data/.secret_key）
SECRET_KEY=

# 数据库存储路径（默认指向 data/media_parser.db）
DATABASE_PATH=data/media_parser.db

# 是否信任反向代理（Nginx / Caddy 等）传递的 X-Forwarded-* 请求头（true / false）
TRUST_PROXY_HEADERS=false

# 是否开启纯 API / 微服务模式（true / false，开启后关闭 Web UI，全接口免 API Key 直接调用且不写数据库请求日志）
API_ONLY=false

# 跨域访问控制（CORS Allowed Origins，默认 * 允许所有来源跨域访问 /api/*，支持逗号分隔多个来源，例如 https://ui.example.com,http://localhost:5173）
# CORS_ORIGINS=*

# 站点对外访问的基础 URL（用于控制台与接口文档展示，可选，例如 https://api.yourdomain.com）
# API_BASE_URL=https://api.yourdomain.com

# 时区配置
TZ=Asia/Shanghai


# ------------------------------------------
# 2. 平台凭据与 Cookie 配置 (Platform Credentials)
# （大部分平台支持匿名免登录解析；当特定链接触发平台风控或需要鉴权时配置）
# ------------------------------------------

# 小红书 Cookie（支持 XHS_COOKIE 或 XIAOHONGSHU_COOKIE）
# 用于部分需要登录才能查看的小红书笔记
XHS_COOKIE=

# 快手 Cookie（支持 KUAISHOU_COOKIE 或 KS_COOKIE）
# 用于应对快手高频反爬拦截（result: 2 / ANTICRAWL_DEFAULT）
KUAISHOU_COOKIE=

# 拼多多 Cookie（支持 PINDUODUO_COOKIE 或 PDD_COOKIE）
# 用于拼多多短视频 dsp_detail 接口鉴权
PINDUODUO_COOKIE=

# 腾讯元宝 / 微信视频号 Cookie（支持 YUANBAO_COOKIE 或 WECHAT_CHANNELS_COOKIE）
# 视频号解析依赖腾讯元宝接口，需提供包含 user_id 和 session 信息的元宝 Cookie
YUANBAO_COOKIE=

# 抖音 Cookie（可选，支持 DOUYIN_COOKIE）
# 场景 1（常规）：短视频 / 普通图文图集 / 音乐 -> 100% 免配，留空即可
# 场景 2（实况图，云服务器提取）：仅填 UIFID 是不行的，必须将【完整登录 Cookie】加上【UIFID】一起填入 DOUYIN_COOKIE！
#                 最少需包含登录字段：sessionid, sessionid_ss, passport_csrf_token, odin_tt 加上 UIFID=xxx;
#                 （注意：uifid 是 Network 中与 Cookie 并列同级的独立请求头，需手动以 UIFID=xxx; 格式拼入）
#                 配置示例：DOUYIN_COOKIE="UIFID=你的uifid; sessionid=xxx; sessionid_ss=xxx; passport_csrf_token=xxx; odin_tt=xxx;"
# 场景 3（放映厅长片 /lvdetail/）：需包含拼图滑块通行证 s_v_web_id=verify_...
DOUYIN_COOKIE=

# 豆包 Cookie（支持 DOUBAO_COOKIE）
# 用于提取豆包 AI 深度会话中的多媒体内容
DOUBAO_COOKIE=

# 即梦 AI Cookie（支持 JIMENG_COOKIE）
# 用于即梦作品页鉴权
JIMENG_COOKIE=

# 微博 Cookie（支持 WEIBO_COOKIE）
# 用于微博长图文与特定视频流提取
WEIBO_COOKIE=

# 知乎 Cookie（可选，支持 ZHIHU_COOKIE）
# 推荐精简字段: d_c0=xxx; z_c0=xxx;
# 用于服务器机房 IP 触发风控或提取登录可见内容时使用
ZHIHU_COOKIE=


# 动态代理 API 提取地址（原生兼容 芝麻代理、巨量IP、青果网络、无忧代理、多米代理 等，支持 JSON 与 IP:端口 纯文本）；留空关闭代理重试，配置说明见 docs/proxy-retry.md。
DYNAMIC_PROXY_API_URL=
# 代理模式：auto（默认，Cookie 校验失败后为该平台开 15 分钟代理窗口）或 always（始终走代理，每次解析轮换 IP）。未配置提取地址时一律直连。
PROXY_MODE=auto
# 同时保留的可分配代理 IP 数（1-100，默认 2）；always 模式按并发量调大。
PROXY_POOL_SIZE=2
# 全服务每秒最多调用提取接口次数（1-20，默认 1），不要超过代理商限制。
PROXY_FETCH_PER_SECOND=1
