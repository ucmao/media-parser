# ==============================================================================
# Media Parser 环境变量配置文件示例 (仅用于说明，请复制本文件为 .env 并在本地配置真实值)
# ==============================================================================

# 1. 核心应用配置
# Flask 密钥，用于 session 安全签名等，生产环境建议更换为随机强密码
SECRET_KEY=default_secret_key

# 服务对外的基础域名 (部分平台需要，若无特定需求可留空)
DOMAIN=

# 2. 媒体处理与缓存配置
# 仅缓存的小文件大小限制（单位：MB），超出此大小将不进行本地持久化缓存直接返回解析结果
MAX_CACHE_SIZE_MB=15

# 3. 平台账号风控 Cookie 配置 (重要)
# 小红书登录 Cookie (解析 pc_feed 等信息流类型链接必备)
# 请填入您在浏览器登录小红书后复制的值（包含 a1 字段）
XIAOHONGSHU_COOKIE=a1=your_a1_cookie_value_here; webId=your_web_id_here

# 豆包 Cookie（可选；匿名解析失败时再配置，请勿提交真实 Cookie）
DOUBAO_COOKIE=
